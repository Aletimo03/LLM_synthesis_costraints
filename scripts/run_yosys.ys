# ----------------------------------------------------------------------------
# run_yosys.ys (Tcl Mode)
# ----------------------------------------------------------------------------

# 1. Read the Verilog design
yosys read_verilog designs/simple.v

# 2. Design Exploration
yosys hierarchy -top simple
yosys proc
yosys opt
yosys fsm
yosys opt

# 3. Handle SDC Constraints
# The 'sdc' command is a built-in Tcl wrapper in Yosys
yosys sdc constraints/generated.sdc

# 4. Techmap
yosys techmap
yosys opt

# 5. Timing-Driven Mapping via ABC
yosys abc

# 6. Final Clean-up
yosys opt_clean -purge

# 7. Reporting
yosys stat
yosys write_verilog reports/synthesis_output.v
yosys write_json reports/simple.json

# Pure Tcl command to close the session gracefully
exit